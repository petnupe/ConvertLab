# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contato@cuidadosmeus.com.br
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=contato@cuidadosmeus.com.br
SMTP_FROM_NAME=ConvertScale
MAIL_TO=contato@cuidadosmeus.com.br
WHATSAPP_SUPPORT_NUMBER=5551xxxxx9103

# Admin area (hidden at /admin) — set the same values on Vercel.
ADMIN_EMAIL=admin@convertlab.com
ADMIN_PASSWORD=strong_password
SESSION_SECRET=generate_with_openssl_rand_base64_32